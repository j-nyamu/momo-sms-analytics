import json
import os
import sqlite3

BASE = os.path.dirname(os.path.abspath(__file__))
DB_FILE = os.path.join(BASE, "momo.db")
SCHEMA_FILE = os.path.join(BASE, "schema.sql")
JSON_FILE = os.path.join(BASE, "..", "data", "processed", "transactions.json")

COLUMNS = [
    "transaction_type", "amount", "currency", "fee", "balance_after",
    "sender", "receiver", "timestamp", "financial_transaction_id",
    "status", "raw_body",
]

with open(JSON_FILE, "r", encoding="utf-8") as f:
    records = json.load(f)

conn = sqlite3.connect(DB_FILE)
with open(SCHEMA_FILE, "r", encoding="utf-8") as f:
    conn.executescript(f.read())

# Reload from scratch so running this twice doesn't duplicate rows
conn.execute("DELETE FROM transactions")
conn.execute("DELETE FROM sqlite_sequence WHERE name = 'transactions'")

placeholders = ", ".join("?" for _ in COLUMNS)
sql = f"INSERT INTO transactions ({', '.join(COLUMNS)}) VALUES ({placeholders})"
conn.executemany(sql, [tuple(r.get(c) for c in COLUMNS) for r in records])
conn.commit()

count = conn.execute("SELECT COUNT(*) FROM transactions").fetchone()[0]
print(f"Loaded {count} transactions into {DB_FILE}")
conn.close()